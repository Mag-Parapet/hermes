DATABASE_URL=postgres://postgres:root@localhost:5432/hermes
JWT_SECRET=super_secret_key_change_this_in_production
RUST_LOG=debug
PORT=3000
STORAGE_ROOT=../storage
STATIC_HOST=https://static.hermes-host.vip
DEFAULT_STORAGE_QUOTA=1048576

MULTER_MAX_FILE_SIZE=104857600
DEFAULT_SSL_ENABLED=true
DEFAULT_SSL_CERT_PATH=/etc/letsencrypt/live/hermes-host.vip-0001/fullchain.pem
DEFAULT_SSL_KEY_PATH=/etc/letsencrypt/live/hermes-host.vip-0001/privkey.pem